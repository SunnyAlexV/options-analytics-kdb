# System configuration: ports and folders, read by scripts/start.sh, stop.sh, status.sh.
# Values already set in the environment win, e.g.  DATA=~/kdbtest bash scripts/start.sh

TP_PORT=${TP_PORT:-5010}     # tickerplant
RDB_PORT=${RDB_PORT:-5011}   # real-time database
HDB_PORT=${HDB_PORT:-5012}   # historical database
GW_PORT=${GW_PORT:-5013}     # gateway

DATA=${DATA:-$HOME/kdbdata}  # everything the system writes lives under here (never in the repo)
TPLOG=$DATA/tplog            # tickerplant log files, one per day: sym2026.10.08
HDB=$DATA/hdb                # historical database: one folder per date
LOGS=$DATA/logs              # each process's console output
RUN=$DATA/run                # process id files

CURRENCY=${CURRENCY:-BTC}
ENGINE_MODE=${ENGINE_MODE:-stream}   # surface engine input: stream (tickerplant subscriber, the standard RTE; default) or poll (read new RDB rows)
export TZ=UTC                # every q process runs on UTC, so "today" and end of day are UTC
